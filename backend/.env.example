# Environment Configuration for LostLink Backend
ENV=development
APP_NAME=LostLink
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Database: SQLite for local dev/testing, PostgreSQL for production / Docker
# DATABASE_URL=sqlite:///./lostlink.db
DATABASE_URL=postgresql+psycopg2://lostlink:lostlink_password@localhost:5432/lostlink

# Authentication / JWT
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_random_32_bytes_hex_string_before_running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Matching Engine Heuristic Weights (Sum = 1.0)
WEIGHT_CATEGORY=0.35
WEIGHT_LOCATION=0.25
WEIGHT_DATE=0.20
WEIGHT_KEYWORD=0.20

# Date Decay Parameter (D = max(0, 100 - DATE_DECAY_RATE * days_diff))
DATE_DECAY_RATE=15.0

# Minimum score threshold for matches
MINIMUM_MATCH_SCORE=20.0
