# ==============================================================================
# LostLink Environment Configuration Template (.env.example)
# ==============================================================================

# --- Application & Server ---
ENV=production
APP_NAME=LostLink
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Database ---
# For local SQLite: sqlite:///./lostlink.db
# For PostgreSQL (Docker / Neon / Render / Supabase):
DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/lostlink_db

# --- Security & Authentication ---
# Generate a strong 32-byte secret key with: openssl rand -hex 32
SECRET_KEY=generate_a_cryptographically_secure_random_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
# Set COOKIE_SECURE=true in production so cookies are transmitted only via HTTPS
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- CORS & CSRF Whitelist ---
# Comma-separated list of allowed origin URLs
CORS_ORIGINS=https://lostlink.onrender.com,http://localhost:5173

# --- Matching Engine Weights (Heuristic 0.0 - 1.0) ---
WEIGHT_CATEGORY=0.35
WEIGHT_LOCATION=0.25
WEIGHT_DATE=0.20
WEIGHT_KEYWORD=0.20
DATE_DECAY_RATE=15.0
CANDIDATE_DATE_WINDOW_DAYS=30
MINIMUM_MATCH_SCORE=20.0

# --- Object Storage (Phase 6: Photo Uploads) ---
# Supported providers: "supabase", "local"
STORAGE_PROVIDER=supabase
STORAGE_MAX_FILE_SIZE_BYTES=5242880
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=lostlink-images

# --- Email Notifications (Phase 7: Double-Blind Notifications) ---
# Supported providers: "resend", "smtp", "console"
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev
# Optional SMTP parameters (if EMAIL_PROVIDER=smtp):
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=

